{
  "name": "slidecraft",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source code-based presentation system. Build slides as React components, present with live audience interaction.",
  "homepage": "https://github.com/Pluggentipsar/slidecraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pluggentipsar/slidecraft.git"
  },
  "bugs": {
    "url": "https://github.com/Pluggentipsar/slidecraft/issues"
  },
  "keywords": [
    "presentation",
    "slides",
    "mdx",
    "react",
    "next.js",
    "framer-motion",
    "supabase",
    "audience",
    "live-poll",
    "interactive"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "present": "concurrently -n dev,tunnel -c cyan,magenta \"next dev\" \"cloudflared tunnel --url http://localhost:3000\"",
    "present:named": "concurrently -n dev,tunnel -c cyan,magenta \"next dev\" \"cloudflared tunnel run slidecraft\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.2.1",
    "next": "16.2.4",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
