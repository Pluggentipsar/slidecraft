# Slidecraft environment variables
#
# Copy this file to `.env.local` and fill in your values.
# Do NOT commit .env.local — it's gitignored.

# ─── Supabase (audience mode: live polls, Q&A, audience-sync) ───
# Required if you want the /audience and /[slug]/presenter features.
# Without these, the app runs but audience-mode is disabled.
#
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ─── Pexels (optional: stock photo search inside the editor) ───
# Free API key from https://www.pexels.com/api/
PEXELS_API_KEY=
